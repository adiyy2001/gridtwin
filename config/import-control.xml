<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC "-//Checkstyle//DTD ImportControl Configuration 1.4//EN" "https://checkstyle.org/dtds/import_control_1_4.dtd">
<import-control pkg="dev.gridtwin">
  <disallow class="java.time.Instant"/>
  <allow pkg=".*" regex="true"/>
  <subpackage name="domain">
    <disallow pkg="jakarta"/>
    <disallow pkg="io.quarkus"/>
    <disallow pkg="io.vertx"/>
    <disallow pkg="io.smallrye"/>
    <disallow pkg="org.eclipse.microprofile"/>
    <disallow pkg="com.fasterxml"/>
    <disallow pkg="dev.gridtwin.cases"/>
    <disallow pkg="dev.gridtwin.api"/>
    <disallow pkg="dev.gridtwin.bench"/>
  </subpackage>
</import-control>
