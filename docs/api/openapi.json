        "required" : [ "id", "name", "bus", "baseKv", "busbars", "nodes", "bays", "switches" ]
      },
      "SummaryStateDto" : {
        "type" : "object",
        "properties" : {
          "totalLoadMw" : {
            "type" : "number",
            "format" : "double"
          },
          "servedLoadMw" : {
            "type" : "number",
            "format" : "double"
          },
          "shedLoadMw" : {
            "type" : "number",
            "format" : "double"
          },
          "totalGenerationMw" : {
            "type" : "number",
            "format" : "double"
          },
          "totalLossMw" : {
            "type" : "number",
            "format" : "double"
          },
          "maxLoading" : {
            "type" : "number",
            "format" : "double"
          },
          "lowestVoltage" : {
            "type" : [ "number", "null" ],
            "format" : "double"
          },
          "overloadedBranches" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "totalLoadMw", "servedLoadMw", "shedLoadMw", "totalGenerationMw", "totalLossMw", "maxLoading", "overloadedBranches" ]
      },
      "SwitchDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "kind" : {
            "$ref" : "#/components/schemas/SwitchKind"
          },
          "bay" : {
            "type" : "string"
          },
          "nodeA" : {
            "type" : "string"
          },
          "nodeB" : {
            "type" : "string"
          },
          "initialPosition" : {
            "$ref" : "#/components/schemas/Position"
          }
        },
        "required" : [ "id", "kind", "bay", "nodeA", "nodeB", "initialPosition" ]
      },
      "SwitchKind" : {
        "type" : "string",
        "enum" : [ "BREAKER", "DISCONNECTOR", "EARTHING_SWITCH" ]
      },
      "SwitchStateDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "position" : {
            "$ref" : "#/components/schemas/Position"
          }
        },
        "required" : [ "id", "position" ]
      },
      "TerminalDto" : {
        "type" : "object",
        "properties" : {
          "node" : {
            "type" : "string"
          },
          "kind" : {
            "$ref" : "#/components/schemas/TerminalKind"
          },
          "equipment" : {
            "type" : "string"
          }
        },
        "required" : [ "node", "kind", "equipment" ]
      },
      "TerminalKind" : {
        "type" : "string",
        "enum" : [ "BRANCH", "LOAD", "GENERATOR" ]
      },
      "TierCountsDto" : {
        "type" : "object",
        "properties" : {
          "secure" : {
            "type" : "integer",
            "format" : "int64"
          },
          "degraded" : {
            "type" : "integer",
            "format" : "int64"
          },
          "blackout" : {
            "type" : "integer",
            "format" : "int64"
          },
          "nonConverged" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "secure", "degraded", "blackout", "nonConverged" ]
      },
      "VersionedStateDto" : {
        "type" : "object",
        "properties" : {
          "version" : {
            "type" : "integer",
            "format" : "int64"
          },
          "state" : {
            "$ref" : "#/components/schemas/StateDto"
          }
        },
        "required" : [ "version", "state" ]
      },
      "ViolationDto" : {
        "type" : "object",
        "properties" : {
          "kind" : {
            "$ref" : "#/components/schemas/ViolationKind"
          },
          "subject" : {
            "type" : "string"
          },
          "value" : {
            "type" : "number",
            "format" : "double"
          },
          "limit" : {
            "type" : [ "number", "null" ],
            "format" : "double"
          },
          "side" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "kind", "subject", "value" ]
      },
      "ViolationKind" : {
        "type" : "string",
        "enum" : [ "BRANCH_OVERLOAD", "VOLTAGE_OUT_OF_BAND", "SLACK_ABOVE_LIMIT", "LOAD_SHED", "ISLAND_COLLAPSE" ]
      },
      "ZonedDateTime" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T12:15:50-04:00" ]
      }
    }
  },
  "paths" : {
    "/api/cases" : {
      "get" : {
        "summary" : "List the cases that can be switched",
        "tags" : [ "cases" ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CaseSummaryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{caseId}" : {
      "get" : {
        "summary" : "Static data of a case",
        "description" : "Buses, branches, generators, loads, schematic layout and the substation description. Pushed states carry values only.",
        "tags" : [ "cases" ],
        "parameters" : [ {
          "name" : "caseId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CaseDetailDto"
                }
              }
            }
          },
          "404" : {
            "description" : "Unknown case",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions" : {
      "post" : {
        "summary" : "Create a session",
        "description" : "Starts a twin of the chosen case with its own switch positions and load factor. The state is pushed over the WebSocket at /ws/sessions/{sessionId}.",
        "tags" : [ "sessions" ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateSession"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Session created at version 1",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionCreatedDto"
                }
              }
            }
          },
          "429" : {
            "description" : "The session cap is reached",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Bad Request"
          }
        }
      }
    },
    "/api/sessions/{sessionId}" : {
      "delete" : {
        "summary" : "Close a session",
        "tags" : [ "sessions" ],
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Session closed"
          }
        }
      }
    },
    "/api/sessions/{sessionId}/analyses/cascade" : {
      "post" : {
        "summary" : "Run the cascade simulation",
        "description" : "Educational simplification. Starts with the trigger outage, then trips the worst branch above the threshold until stable or dark. Every step carries a full state for replay.",
        "tags" : [ "analyses" ],
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RunCascade"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CascadeDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Unknown trigger or option out of range",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      },
      "get" : {
        "summary" : "Read the kept cascade result for the current state",
        "tags" : [ "analyses" ],
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CascadeDto"
                }
              }
            }
          },
          "404" : {
            "description" : "Unknown session, or no cascade run for the current state",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/analyses/n-1" : {
      "post" : {
        "summary" : "Run N-1 contingency analysis",
        "description" : "One outage per branch and generator in service, solved from a warm start in parallel and ranked by severity. The result is kept until the state changes.",
        "tags" : [ "analyses" ],
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ContingencyReportDto"
                }
              }
            }
          }
        }
      },
      "get" : {
        "summary" : "Read the kept N-1 result for the current state",
        "tags" : [ "analyses" ],
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ContingencyReportDto"
                }
              }
            }
          },
          "404" : {
            "description" : "Unknown session, or no N-1 run for the current state",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/analyses/n-1/{contingencyId}" : {
      "get" : {
        "summary" : "Preview one contingency",
        "description" : "The full state under that outage, taken from the kept N-1 run without a new solve. Contingency ids look like branch:L2-4 or generator:G1.",
        "tags" : [ "analyses" ],
        "parameters" : [ {
          "name" : "contingencyId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ContingencyPreviewDto"
                }
              }
            }
          },
          "404" : {
            "description" : "Unknown session or contingency, or no N-1 run for the current state",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/load-factor" : {
      "put" : {
        "summary" : "Scale all loads",
        "description" : "The factor must be between 0.5 and 1.5. Generators keep their setpoints and the slack absorbs the change.",
        "tags" : [ "sessions" ],
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SetLoadFactor"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VersionedStateDto"
                }
              }
            }
          },
          "400" : {
            "description" : "The factor is outside the range",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/state" : {
      "get" : {
        "summary" : "Read the current versioned state",
        "tags" : [ "sessions" ],
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VersionedStateDto"
                }
              }
            }
          },
          "404" : {
            "description" : "Unknown session",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/switches/{switchId}" : {
      "post" : {
        "summary" : "Operate a switch",
        "description" : "Interlocks are checked first. An accepted operation solves the network, raises the version and pushes the state. Operating a switch into its current position changes nothing.",
        "tags" : [ "sessions" ],
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "switchId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OperateSwitch"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VersionedStateDto"
                }
              }
            }
          },
          "409" : {
            "description" : "The operation is refused by an interlock",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404" : {
            "description" : "Unknown session or switch",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Bad Request"
          }
        }
      }
    }
  },
  "info" : {
    "title" : "gridtwin API",
    "version" : "0.1.0",
    "description" : "Educational digital twin of a transmission network: switching, AC power flow, N-1 and cascade analysis. Not for operational use."
  }
}
